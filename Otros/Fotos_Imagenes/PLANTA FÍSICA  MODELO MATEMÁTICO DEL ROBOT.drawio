        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% NODO RAÍZ\n    PLANTA[\&quot;&lt;b&gt;PLANTA FÍSICA / MODELO MATEMÁTICO&lt;/b&gt;&lt;br/&gt;Péndulo Invertido sobre Ruedas&lt;br/&gt;&lt;i&gt;G(s) = 9.32 / (s² - 78.4)&lt;/i&gt;\&quot;]\n\n    %% RAMAS PRINCIPALES\n    PLANTA --&gt; PID[\&quot;&lt;b&gt;1. CONTROL PID CLÁSICO&lt;/b&gt;\&quot;]\n    PLANTA --&gt; FUZZY[\&quot;&lt;b&gt;2. CONTROL DIFUSO&lt;/b&gt;&lt;br/&gt;(Mamdani / FLC)\&quot;]\n    PLANTA --&gt; RNA[\&quot;&lt;b&gt;3. CONTROL RNA&lt;/b&gt;&lt;br/&gt;(Perceptrón Multicapa - MLP)\&quot;]\n\n    %% SUBGRAFO RAMA PID\n    subgraph RAMA_PID [\&quot;Línea de Control PID\&quot;]\n        PID --&gt; PID_TEORIA[\&quot;&lt;b&gt;[Teoría]&lt;/b&gt;&lt;br/&gt;Sintonización Ziegler-Nichols,&lt;br/&gt;Lugar geométrico de las raíces y asignación de polos\&quot;]\n        PID_TEORIA --&gt; PID_DATOS[\&quot;&lt;b&gt;[Datos]&lt;/b&gt;&lt;br/&gt;Parámetros electromecánicos del modelo:&lt;br/&gt;(M, m, l, Jp, Kt, Ke, Ra, r)\&quot;]\n        PID_DATOS --&gt; PID_SIMULINK[\&quot;&lt;b&gt;[Simulink]&lt;/b&gt;&lt;br/&gt;Bloque PID Controller + PID Tuner&lt;br/&gt;(Ajuste de respuesta transitoria y márgenes de fase)\&quot;]\n        PID_SIMULINK --&gt; PID_EXPORT[\&quot;&lt;b&gt;[Export]&lt;/b&gt;&lt;br/&gt;Ganancias escalares Kp, Ki, Kd y cota anti-windup&lt;br/&gt;→ &lt;code&gt;include/ConfigTuning.h&lt;/code&gt;\&quot;]\n    end\n\n    %% SUBGRAFO RAMA FUZZY\n    subgraph RAMA_FUZZY [\&quot;Línea de Control Difuso\&quot;]\n        FUZZY --&gt; FUZZY_TEORIA[\&quot;&lt;b&gt;[Teoría]&lt;/b&gt;&lt;br/&gt;Ponce (2010), Cap. 2:&lt;br/&gt;Particiones difusas, conjuntos triangulares,&lt;br/&gt;FAM en plano de fase y centroide (COG)\&quot;]\n        FUZZY_TEORIA --&gt; FUZZY_DATOS[\&quot;&lt;b&gt;[Datos]&lt;/b&gt;&lt;br/&gt;Límites físicos reales de operación:&lt;br/&gt;Error ±20°, dError ±120°/s, Salida PWM ±255\&quot;]\n        FUZZY_DATOS --&gt; FUZZY_SIMULINK[\&quot;&lt;b&gt;[Simulink]&lt;/b&gt;&lt;br/&gt;Fuzzy Logic Designer (.fis)&lt;br/&gt;+ Bloque Fuzzy Logic Controller (Mamdani)\&quot;]\n        FUZZY_SIMULINK --&gt; FUZZY_EXPORT[\&quot;&lt;b&gt;[Export]&lt;/b&gt;&lt;br/&gt;Vértices de funciones de membresía y matriz FAM&lt;br/&gt;→ &lt;code&gt;src/control/ControlFuzzy.cpp&lt;/code&gt;\&quot;]\n    end\n\n    %% SUBGRAFO RAMA RNA\n    subgraph RAMA_RNA [\&quot;Línea de Control Neuronal\&quot;]\n        RNA --&gt; RNA_TEORIA[\&quot;&lt;b&gt;[Teoría]&lt;/b&gt;&lt;br/&gt;Ponce (2010), Caps. 1 y 3:&lt;br/&gt;Aproximación universal, retropropagación,&lt;br/&gt;activación tanh y optimización Levenberg-Marquardt\&quot;]\n        RNA_TEORIA --&gt; RNA_DATOS[\&quot;&lt;b&gt;[Datos]&lt;/b&gt;&lt;br/&gt;Dataset experimental UDP en tiempo real (Modo C):&lt;br/&gt;(Pitch, dPitch, PWM @ 100 Hz, N ≥ 3000)\&quot;]\n        RNA_DATOS --&gt; RNA_SIMULINK[\&quot;&lt;b&gt;[Simulink]&lt;/b&gt;&lt;br/&gt;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7SKs4ag31rZkXBdYvl4x-1">
