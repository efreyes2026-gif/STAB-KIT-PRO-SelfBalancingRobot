  <diagram name="Página-1" id="XVV7BPjSSAjPHSQ6ufHc">
    <mxGraphModel dx="2348" dy="1719" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" background="light-dark(#FFFFFF,#FFFFFF)" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% =========================================================================\n    %% SETUP GENERAL\n    %% =========================================================================\n    subgraph SETUP [\&quot;main.cpp: SETUP GENERAL\&quot;]\n        S1[\&quot;Inicio del Sistema\&quot;] --&gt; S2[\&quot;Cargar Constantes de Laboratorio, Hardware y Tuning\&quot;]\n        S2 --&gt; S3[\&quot;Inicializar Buses: Serial (115200) e I2C (D21, D22)\&quot;]\n        S3 --&gt; S4[\&quot;Invocación de Setup por Módulo:&lt;br/&gt;• Inclinometro::iniciar()&lt;br/&gt;• Encoders::iniciar()&lt;br/&gt;• Motores::iniciar()&lt;br/&gt;• HMI_OLED::iniciar()&lt;br/&gt;• Controladores (PID, Fuzzy, RNA)::iniciar()\&quot;]\n    end\n\n    %% =========================================================================\n    %% MÁQUINA DE ESTADOS PRINCIPAL\n    %% =========================================================================\n    SETUP --&gt; ME[\&quot;main.cpp: MÁQUINA DE ESTADOS\&quot;]\n    \n    subgraph MAQUINA [\&quot;Planificador y Navegación HMI (2 Botones)\&quot;]\n        ME --&gt; M1[\&quot;Control de Periodo Estricto (dt = 10 ms / 100 Hz)\&quot;]\n        M1 --&gt; M2{\&quot;Evaluar Modo Operativo&lt;br/&gt;(Botón PANTALLA - GPIO 32)\&quot;}\n    end\n\n    %% =========================================================================\n    %% MODO A: SIMULACIÓN HIL PROTEUS\n    %% =========================================================================\n    M2 --&gt;|Modo A| MODO_A\n\n    subgraph MODO_A [\&quot;MODO A: Simulación HIL (Wokwi / Proteus)\&quot;]\n        A_SENSORES[\&quot;1. Adquisición de Inclinometría:&lt;br/&gt;• Fusión MPU-6050 (Filtro Complementario)&lt;br/&gt;• GY-61 (1695, 1795, 2009)\&quot;]\n        A_ENCODERS[\&quot;2. Adquisición de Odometría:&lt;br/&gt;• Cuentas ISR (48 PPR)&lt;br/&gt;• Estimación de Velocidad / Posición\&quot;]\n        \n        A_SENSORES --&gt; A_SELECTOR{\&quot;3. Selector Ley de Control&lt;br/&gt;(Botón SISTEMA - GPIO 33)\&quot;}\n        A_ENCODERS --&gt; A_SELECTOR\n\n        A_SELECTOR --&gt;|Opción 1| A_PID[\&quot;Algoritmo PID&lt;br/&gt;(Anti-Windup + Deadband)\&quot;]\n        A_SELECTOR --&gt;|Opción 2| A_FUZZY[\&quot;Lógica Difusa (Fuzzy)&lt;br/&gt;(Mamdani / Sugeno 5x5)\&quot;]\n        A_SELECTOR --&gt;|Opción 3| A_RNA[\&quot;Red Neuronal (RNA)&lt;br/&gt;(MLP 2-5-1 Tanh Feedforward)\&quot;]\n\n        A_PID --&gt; A_CALC[\&quot;Calcular Esfuerzo de Control&lt;br/&gt;(PWM_A, PWM_B)\&quot;]\n        A_FUZZY --&gt; A_CALC\n        A_RNA --&gt; A_CALC\n\n        A_CALC --&gt; A_ACTUADOR[\&quot;4. Desacople Físico y Envío UART HIL:&lt;br/&gt;• Motores físicos frenados (Seguridad)&lt;br/&gt;• Transmisión Trama Serial: &#39;M,pwmA,dirA,pwmB,dirB\\\\n&#39;&lt;br/&gt;• Vía Sockets TCP / bridge.py / VSPE hacia Proteus\&quot;]\n    end\n\n    %% =========================================================================\n    %% MODO B: HARDWARE REAL\n    %% =========================================================================\n    M2 --&gt;|Modo B| MODO_B\n\n    subgraph MODO_B [\&quot;MODO B: Hardware Real (Equilibrio Activo)\&quot;]\n        B_SENSORES[\&quot;1. Adquisición de Inclinometría:&lt;br/&gt;• Fusión MPU-6050 (Filtro Complementario)&lt;br/&gt;• GY-61 (1695, 1795, 2009)\&quot;]\n        B_ENCODERS[\&quot;2. Adquisición de Odometría:&lt;br/&gt;• Cuentas ISR (48 PPR)&lt;br/&gt;• Estimación de Velocidad / Posición\&quot;]\n\n        B_SENSORES --&gt; B_SELECTOR{\&quot;3. Selector Ley de Control&lt;br/&gt;(Botón SISTEMA - GPIO 33)\&quot;}\n        B_ENCODERS --&gt; B_SELECTOR\n\n        B_SELECTOR --&gt;|Opción 1| B_PID[\&quot;Algoritmo PID&lt;br/&gt;(Anti-Windup + Deadband)\&quot;]\n        B_SELECTOR --&gt;|Opción 2| B_FUZZY[\&quot;Lógica Difusa (Fuzzy)&lt;br/&gt;(Mamdani / Sugeno 5x5)\&quot;]\n        B_SELECTOR --&gt;|Opción 3| B_RNA[\&quot;Red Neuronal (RNA)&lt;br/&gt;(MLP 2-5-1 Tanh Feedforward)\&quot;]\n\n        B_PID --&gt; B_CALC[\&quot;Calcular Esfuerzo de Control&lt;br/&gt;(PWM_A, PWM_B)\&quot;]\n        B_FUZZY --&gt; B_CALC\n        B_RNA --&gt; B_CALC\n\n        B_CALC --&gt; B_ACTUADOR[\&quot;4. Excitación de Hardware Directo:&lt;br/&gt;• Llamar Módulo Motores / TB6612FNG&lt;br/&gt;• Salidas PWM independientes (PWMA, PWMB)&lt;br/&gt;• Dirección física (AIN1/2, BIN1/2)&lt;br/&gt;• LEDs de indicación de sentido\&quot;]\n    end\n\n    %% =========================================================================\n    %% MODO C: ENLACE MATLAB WIFI UDP\n    %% =========================================================================\n    M2 --&gt;|Modo C| MODO_C\n\n    subgraph MODO_C [\&quot;MODO C: Enlace MATLAB (Fase WiFi UDP)\&quot;]\n        C1[\&quot;Adquisición de Inclinometría y Odometría\&quot;] --&gt; C2[\&quot;Empaquetado de Datos Experimentales&lt;br/&gt;[Pitch, Derivada, Encoders, PWM]\&quot;]\n        C2 --&gt; C3[\&quot;Transmisión Inalámbrica por Sockets UDP&lt;br/&gt;hacia MATLAB en la PC (Captura para RNA)\&quot;]\n    end\n\n    %% =========================================================================\n    %% MODO D: BANCO DE PRUEBAS\n    %% =========================================================================\n    M2 --&gt;|Modo D| MODO_D\n\n    subgraph MODO_D [\&quot;MODO D: Banco de Pruebas (Lazo Abierto)\&quot;]\n        D_SUB{\&quot;Submodo de Test&lt;br/&gt;(Botón SISTEMA - GPIO 33)\&quot;}\n        D_SUB --&gt;|Submodo 1| D1[\&quot;Test Inclinometría:&lt;br/&gt;Monitoreo MPU-6050 y ADC34 GY-61\&quot;]\n        D_SUB --&gt;|Submodo 2| D2[\&quot;Test Encoders:&lt;br/&gt;Conteo de pulsos ISR en D26 y D27\&quot;]\n        D_SUB --&gt;|Submodo 3| D3[\&quot;Test Rampa Motores:&lt;br/&gt;Rampa Adelante -&gt; Freno -&gt; Rampa Atrás -&gt; Freno\&quot;]\n    end\n\n    %% =========================================================================\n    %% CAPA HMI Y VISUALIZACIÓN OLED COMÚN\n    %% =========================================================================\n    A_ACTUADOR --&gt; HMI_REFRESCO\n    B_ACTUADOR --&gt; HMI_REFRESCO\n    C3 --&gt; HMI_REFRESCO\n    D1 --&gt; HMI_REFRESCO\n    D2 --&gt; HMI_REFRESCO\n    D3 --&gt; HMI_REFRESCO\n\n    subgraph HMI_SYS [\&quot;Módulo HMI / OLED SH1106\&quot;]\n        HMI_REFRESCO[\&quot;Lectura No Bloqueante con Debounce:&lt;br/&gt;• Botón PANTALLA (GPIO 32): Alterna Modos Principales&lt;br/&gt;• Botón SISTEMA (GPIO 33): Conmuta Subestados / Leyes\&quot;]\n        HMI_REFRESCO --&gt; OLED_DRAW[\&quot;Refresco OLED SH1106 según Vista Activa:&lt;br/&gt;• Standby / Modo A HIL&lt;br/&gt;• Modo B con Telemetría [PID / FUZZY / RNA]&lt;br/&gt;• Modo C Telemetría UDP&lt;br/&gt;• Modo D Vistas de Banco\&quot;]\n    end\n\n    OLED_DRAW --&gt; M1&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="gjDqUFxs86tQEOCkHrLC-1">
